{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "view gxa deployment logs",
			"type": "shell",
			"command": "stern",
			"args": ["-n", "${input:namespace}", "deployment/gxa"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],		
		}		
	],
	"inputs": [
		{
			"id": "namespace",
			"type": "pickString",
			"description": "Select the namespace to view the logs for the gxa deployment",
			"default": "gxa-test",
			"options": 
				[
					"gxa-test",
					"gxa-ci",
					"gxa-staging",
					"gxa-public"
				]
		}
	]
}