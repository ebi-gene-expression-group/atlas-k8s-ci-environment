# Copy to .env and fill in secrets / URLs for your cluster.

K8S_CONTEXT=fg-public

# Cluster ingress DNS suffix (no environment prefix). Chart builds {ENV}.{INGRESS_HOST_BASE}.
# Example: test.hh-webadmin-35.wp-k8s.ebi.ac.uk when ENV=test and INGRESS_HOST_BASE=hh-webadmin-35.wp-k8s.ebi.ac.uk
INGRESS_HOST_BASE=

# Jenkins (task trigger-indexing, task trigger-bioentities, task jenkins-params)
JENKINS_URL=http://45.88.80.151:30004/jenkins
JENKINS_USER=
JENKINS_TOKEN=
# JENKINS_BIOENTITIES_JOB=H_bioentities_loading_pipeline_bulk_and_sc  # optional override

# Experiment JSON endpoints for gap analysis (task gxa-experiments-gap).
# SOURCE = production catalogue; TARGET = deployment you load into / compare against.
GXA_SOURCE_JSON_URL=https://www.ebi.ac.uk/gxa/json/experiments
GXA_TARGET_JSON_URL=http://hh-rke-wp-webadmin-35-master-1.caas.ebi.ac.uk:30240/gxa/json/experiments

# Live Tavern system tests (task test-system). Optional if ENV is ci|staging|public|fallback
# (then base_url is read from config/gxa-environments.yaml).
# GXA_SYSTEM_BASE=http://hh-rke-wp-webadmin-35-worker-1.caas.ebi.ac.uk:30932/gxa

# Jenkins Loading_bulk_using_indexing_pipeline_slurm — must match the GXA_TARGET deployment.
# k8s_test corresponds to Helm ENV=test (namespace gxa-test). See config/gxa-environments.yaml.
TARGET_ENVIRONMENT=k8s_test
