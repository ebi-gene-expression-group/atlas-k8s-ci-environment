{
  "info": {
    "_postman_id": "3e447c7a-73bc-497e-a9f8-19f48200304a",
    "name": "SCXA - stress",
    "description": "Hit scxa experiment pages. Run the collection (or just 'Fetch experiments') - it will automatically iterate over each experiment and issue the HTML/JSON requests. Uses pm.execution.setNextRequest to chain requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "17583635"
  },
  "item": [
    {
      "name": "Fetch experiments",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () { ",
              "    pm.response.to.have.status(200);",
              "});",
              "const limit = parseInt(pm.collectionVariables.get('limit') || '0', 10);",
              "let accessions = [];",
              "try {",
              "    const json = pm.response.json();",
              "    accessions = (json.experiments || []).map(e => e.experimentAccession).filter(Boolean);",
              "} catch (e) {",
              "    pm.test('Parse experiments response', () => pm.expect.fail('Failed to parse JSON: ' + e.message));",
              "    throw e;",
              "}",
              "if (limit > 0) accessions = accessions.slice(0, limit);",
              "pm.collectionVariables.set('accessions', JSON.stringify(accessions));",
              "pm.collectionVariables.set('currentIndex', '0');",
              "pm.collectionVariables.set('accession', accessions[0] || '');",
              "pm.execution.setNextRequest(accessions.length > 0 ? 'marker genes (HTML)' : null);",
              "pm.test('Fetched ' + accessions.length + ' experiments', () => pm.expect(accessions.length).to.be.above(0));"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/json/experiments",
          "host": ["{{base_url}}"],
          "path": ["json", "experiments"]
        }
      },
      "response": []
    },
