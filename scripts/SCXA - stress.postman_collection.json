        {
          "name": "clusters(JSON)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () { ",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const accessions = JSON.parse(pm.collectionVariables.get('accessions'));",
                  "const currentIndex = parseInt(pm.collectionVariables.get('currentIndex'), 10);",
                  "if (currentIndex + 1 < accessions.length) {",
                  "    pm.collectionVariables.set('currentIndex', String(currentIndex + 1));",
                  "    pm.collectionVariables.set('accession', accessions[currentIndex + 1]);",
                  "    pm.execution.setNextRequest('marker genes (HTML)');",
                  "} else {",
                  "    pm.execution.setNextRequest(null);",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
