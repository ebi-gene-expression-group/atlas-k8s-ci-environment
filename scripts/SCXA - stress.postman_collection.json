              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/json/cell-plots/{{accession}}/expression/?plotMethod=UMAP&accessKey=&n_neighbors=20",
              "host": ["{{base_url}}"],
              "path": ["json", "cell-plots", "{{accession}}", "expression", ""],
              "query": [
                { "key": "plotMethod", "value": "UMAP" },
